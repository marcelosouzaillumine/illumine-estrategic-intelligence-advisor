{
  "firestore": {
    "database": "ai-studio-ef086d54-5c25-444a-bc16-5c7264f7cde5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/generate-advisory-parecer",
        "function": "generateAdvisoryParecer"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
