{
  "root": true,
  "env": {
    "browser": true,
    "es2020": true
  },
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "module"
  },
  "rules": {
    "no-console": ["error", { "allow": ["warn", "error"] }]
  },
  "overrides": [
    {
      "files": ["src/services/logging/InstitutionalLogger.ts", "scripts/**/*.cjs", "scripts/**/*.ts", "vite.config.ts"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
