{
  "name": "illumine-strategic-intelligence-advisor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "prebuild": "npm run typecheck",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "self-audit": "tsx src/scripts/runActiveGovernance.ts",
    "antigravity:audit": "tsx src/scripts/runAntiGravityAudit.ts",
    "institutional-continuity:audit": "tsx src/scripts/runInstitutionalContinuityGovernanceAudit.ts",
    "demo-isolation:audit": "tsx src/scripts/runDemoIsolationAudit.ts",
    "executive-command:audit": "tsx src/scripts/runExecutiveCommandGovernanceAudit.ts",
    "operational-governance:audit": "tsx src/scripts/runOperationalLanguageAudit.ts",
    "strategic-intelligence:audit": "tsx src/scripts/runStrategicIntelligenceAudit.ts",
    "board-pack:audit": "tsx src/scripts/runInstitutionalBoardPackAudit.ts",
    "runtime-contract:audit": "tsx src/scripts/runRuntimeContractAudit.ts",
    "governance:audit": "npm run self-audit && npm run test:fiduciary && npm run war-gaming:audit && npm run operating-pressure:audit && npm run institutional-continuity:audit && npm run demo-isolation:audit && npm run design:audit:bp",
    "governance:command:center:audit": "tsx src/scripts/runGovernanceCommandCenterAudit.ts",
    "executive:cognitive:audit": "tsx src/scripts/runExecutiveCognitiveAudit.ts",
    "institutional:memory:audit": "tsx src/scripts/runInstitutionalMemoryAudit.ts",
    "institutional:causality:audit": "tsx src/scripts/runInstitutionalCausalityAudit.ts",
    "scenario:simulation:audit": "tsx src/scripts/runScenarioSimulationAudit.ts",
    "validate:architecture": "node scripts/validate_architecture_boundaries.cjs && node scripts/validate_viewmodels.cjs && node scripts/validate_cami_guardrail.cjs",
    "lint": "tsc -p tsconfig.test.json --noEmit",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json --noEmit && tsx --test tests/*.test.ts tests/*.test.tsx",
    "test:fiduciary": "tsc -p tsconfig.test.json --noEmit && tsx --test tests/fiduciary-governance.test.ts",
    "test:rules": "firebase emulators:exec --only firestore \"node tests/firestore/rules.test.mjs\"",
    "architecture:lint": "node packages/tooling/architecture-linter/index.cjs",
    "architecture:verify": "node packages/tooling/architecture-linter/index.cjs verify",
    "architecture:experience": "node packages/tooling/architecture-linter/index.cjs experience",
    "architecture:registry": "node packages/tooling/architecture-linter/index.cjs registry",
    "architecture:observatory": "node packages/tooling/architecture-observatory/index.cjs",
    "architecture:audit": "tsx src/scripts/runArchitectureAudit.ts",
    "imports:audit": "tsx src/scripts/runImportsAudit.ts",
    "mocks:audit": "tsx src/scripts/runMocksAudit.ts",
    "docs:audit": "tsx src/scripts/runDocsAudit.ts",
    "design:audit": "npm run design:audit:report",
    "design:audit:bp": "tsx src/scripts/runDesignTypographyAudit.ts --mode=bp",
    "design:audit:report": "tsx src/scripts/runDesignTypographyAudit.ts --mode=report",
    "design:audit:strict": "tsx src/scripts/runDesignTypographyAudit.ts --mode=strict",
    "audit:structural": "tsx scripts/runStructuralCapitalAudit.ts",
    "audit:consoles": "node scripts/audit_consoles.cjs",
    "war-gaming:audit": "tsx src/scripts/runWarGamingGovernanceAudit.ts",
    "operating-pressure:audit": "tsx src/scripts/runOperatingPressureGovernanceAudit.ts",
    "production:hardening:audit": "tsx src/scripts/runProductionHardeningAudit.ts",
    "pilot:operations:audit": "tsx src/scripts/runPilotOperationsAudit.ts",
    "architecture:certification": "npm run architecture:lint && npm run architecture:observatory && npm run validate:architecture",
    "financial:certification": "npx tsx src/governance/financial-governance.guard.ts && npx tsx --test src/tests/financial-integrity/*.test.ts",
    "sync:deploy": "node scripts/sync_deploy.cjs",
    "release:check": "npm run typecheck && npm run test && npm run governance:audit && npm run governance:command:center:audit && npm run executive:cognitive:audit && npm run institutional:memory:audit && npm run institutional:causality:audit && npm run scenario:simulation:audit && npm run production:hardening:audit && npm run pilot:operations:audit && npm run architecture:audit && npm run imports:audit && npm run mocks:audit && npm run docs:audit && npm run build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@fontsource-variable/geist": "^5.2.9",
    "@google/genai": "^1.29.0",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-pdf/renderer": "^4.5.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.2.1",
    "dotenv": "^17.2.3",
    "firebase": "^12.12.1",
    "html2canvas": "^1.4.1",
    "i18next": "^26.3.6",
    "idb-keyval": "^6.3.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "^5.7.284",
    "pptxgenjs": "^4.0.1",
    "radix-ui": "^1.4.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-i18next": "^17.0.11",
    "react-is": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "recharts": "^3.8.1",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.4.1",
    "firebase-admin": "^13.10.0",
    "global-jsdom": "^29.0.0",
    "jest": "^30.4.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.14",
    "ts-morph": "^28.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
