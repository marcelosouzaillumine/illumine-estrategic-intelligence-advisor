{
  "name": "illumine-strategic-intelligence-advisor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "prebuild": "npm run governance:audit",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "governance:audit": "tsx src/scripts/runActiveGovernance.ts",
    "executive:cognitive:audit": "tsx src/scripts/runExecutiveCognitiveAudit.ts",
    "institutional:memory:audit": "tsx src/scripts/runInstitutionalMemoryAudit.ts",
    "institutional:causality:audit": "tsx src/scripts/runInstitutionalCausalityAudit.ts",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && tsx --test tests/*.test.ts",
    "test:rules": "firebase emulators:exec --only firestore \"node tests/firestore/rules.test.mjs\"",
    "architecture:audit": "tsx src/scripts/runArchitectureAudit.ts",
    "imports:audit": "tsx src/scripts/runImportsAudit.ts",
    "mocks:audit": "tsx src/scripts/runMocksAudit.ts",
    "docs:audit": "tsx src/scripts/runDocsAudit.ts",
    "audit:structural": "tsx scripts/runStructuralCapitalAudit.ts",
    "production:hardening:audit": "tsx src/scripts/runProductionHardeningAudit.ts",
    "release:check": "npm run typecheck && npm run test && npm run governance:audit && npm run executive:cognitive:audit && npm run institutional:memory:audit && npm run institutional:causality:audit && npm run production:hardening:audit && npm run architecture:audit && npm run imports:audit && npm run mocks:audit && npm run docs:audit && npm run build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@fontsource-variable/geist": "^5.2.9",
    "@google/genai": "^1.29.0",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.2.1",
    "dotenv": "^17.2.3",
    "firebase": "^12.12.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "^5.7.284",
    "radix-ui": "^1.4.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-is": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "recharts": "^3.8.1",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "firebase-admin": "^13.10.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
